#!/usr/bin/ucode
import {connect} from 'ubus';
import * as uloop from 'uloop';
import {watchdog} from './e5-usb-watch.uc';
uloop.init();
const watch=watchdog(), bus=connect(null,2);
if(!bus)die('e5-usb-watch: ubus unavailable\n');
let timer;
function event() {
    try {timer.set(watch.tick());}
    catch(e) {watch.stop();warn('e5-usb-watch: '+e+'\n');exit(1);}
}
timer=uloop.timer(-1,event);
const usb=bus.listener('e5.usb',event), supply=bus.listener('unisoc.battery',event);
if(!usb || !supply)die('e5-usb-watch: event subscription failed\n');
const term=uloop.signal(15,()=>uloop.end()), interrupt=uloop.signal(2,()=>uloop.end());
try {event();uloop.run();} catch(e) {timer.cancel();watch.stop();die('e5-usb-watch: '+e+'\n');}
timer.cancel();watch.stop();
