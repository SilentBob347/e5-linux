#!/usr/bin/ucode
// Native events plus the original 30-second safety deadline. No shell loop.
import { connect } from 'ubus';
import * as uloop from 'uloop';
import { controller } from './e5-charge-core.uc';
const ctl=controller();
if(ARGV[0]=='status') {print(ctl.status());exit(0);}
if(length(ARGV))die('Usage: e5-charge [status]\n');
uloop.init();
function fail(error) {
    try {ctl.stop();} catch(e) {warn('e5-charge: release failed: '+e+'\n');}
    warn('e5-charge: '+error+'\n');exit(1);
}
try {ctl.init();} catch(e) {fail(e);}
const bus=connect(null,2);
if(!bus)fail('ubus unavailable');
let timer;
function tick() {
    try {ctl.tick();}
    catch(e) {fail(e);}
}
timer=uloop.timer(-1,()=>{tick();timer.set(30000);});
// Subscribe before boot state is read: no lost attach between read and listen.
const event=bus.listener('unisoc.battery',tick);
if(!event)fail('battery event subscription failed');
const term=uloop.signal(15,()=>uloop.end()), interrupt=uloop.signal(2,()=>uloop.end());
try {
    tick();timer.set(30000);
    uloop.run();
} catch(e) {
    timer.cancel();fail(e);
}
timer.cancel();ctl.stop();
