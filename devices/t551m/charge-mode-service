#!/bin/sh /etc/rc.common
# Synchronous charge-only gate after hardware/logging. Normal boots start CP
# at S09; charger boots must not start it until this gate permits normal boot.
# A manual service start on a running system must never re-enter charging.
START=14

boot() {
    /usr/bin/python3 /usr/libexec/e5-charge-mode
    if [ -e /run/e5-vendor-deferred ]; then
        /etc/init.d/e5-vendor start && rm -f /run/e5-vendor-deferred
    fi
}
