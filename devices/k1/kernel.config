# Board delta on a complete, tested UMS9620 platform configuration.
CONFIG_LOCALVERSION="-k1-bringup1"
CONFIG_LOCALVERSION_AUTO=n
# The original K1 DT/bootloader selects ILI9488. No donor panel override.
CONFIG_CMDLINE="earlycon=sprd_serial,0x20210000,115200n8 console=ttyS1,115200n8 console=tty0 loglevel=7 log_buf_len=4M rdinit=/init panic=10 fw_devlink=permissive"

CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y
CONFIG_THERMAL_NETLINK=y
CONFIG_UMS9620_LPINTC=m
