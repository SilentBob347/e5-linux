# P720S20 stock: UMS9620, UFS 4Kn, 480x854 two-lane DSI, SPI AXS15205.
CONFIG_LOCALVERSION="-changxing60-bringup4"
CONFIG_LOCALVERSION_AUTO=n
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_BSG=y
CONFIG_SCSI_UFS_SPRD_QOGIRN6PRO=y
CONFIG_SCSI_UFS_SPRD=n
CONFIG_NVMEM=y
CONFIG_NVMEM_SPRD_EFUSE=y
CONFIG_SPI_SPRD=m
# Initial RAM-only probe: do not bind another board's touch/charging/PA.
CONFIG_TOUCHSCREEN_TLSC6X=n
CONFIG_TOUCHSCREEN_ST7123=n
CONFIG_TOUCHSCREEN_AXS15205=m
CONFIG_CHARGER_AW32257=n
CONFIG_CHARGER_BQ2560X_SPRD=m
CONFIG_SND_SOC_AW883XX_FACTORY=n
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_CMA_SIZE_MBYTES=64
CONFIG_CMDLINE="earlycon=sprd_serial,0x20210000,115200n8 console=ttyS1,115200n8 console=tty0 loglevel=7 log_buf_len=4M rdinit=/init panic=10 fw_devlink=permissive cma=64M@0-4G"
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y
CONFIG_THERMAL_NETLINK=y
CONFIG_UMS9620_LPINTC=m
